#include <gtest/gtest.h>
#include <vector>
using namespace std;

#include "../NN_<pattern>.cpp"   // 直接 include 被测源文件

// ============================================================
// 常规用例
// ============================================================

TEST(<函数名>Test, BasicCase) {
  vector<int> nums = {2, 7, 11, 15};
  EXPECT_EQ(<函数名>(nums, 9), 0);
}

TEST(<函数名>Test, <第二个常规场景>) {
  // 期望值推导：<一行说明>
  EXPECT_EQ(<函数名>(...), ...);
}

// ============================================================
// 边界用例
// ============================================================

TEST(<函数名>Test, EmptyInput) {
  EXPECT_EQ(<函数名>(...), <零值>);
}

TEST(<函数名>Test, SingleElement) {
  EXPECT_EQ(<函数名>(...), ...);
}

TEST(<函数名>Test, AllSameElements) {
  EXPECT_EQ(<函数名>(...), ...);
}

// ============================================================
// 易错用例
// ============================================================

TEST(<函数名>Test, <题目专属陷阱>) {
  // 为什么是这个期望值：<指出错误写法会得到什么错误结果>
  EXPECT_EQ(<函数名>(...), ...);
}

// ============================================================
// 规模用例（验证不退化）
// ============================================================

TEST(<函数名>Test, LargeInput) {
  // n = <规模>，暴力解会超时/退化，正确实现应线性完成
  vector<int> big;
  big.reserve(10000);
  for (int i = 0; i < 10000; ++i) {
    big.push_back(i % 100);
  }
  EXPECT_EQ(<函数名>(big, ...), ...);
}

